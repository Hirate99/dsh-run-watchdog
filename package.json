{
  "name": "@mskyurina/dsh-run-watchdog",
  "version": "0.1.3",
  "description": "Purpose-aware monitoring for DeepSeek Harness long-running commands",
  "main": "dist/index.js",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "build": "tsc --emitDeclarationOnly && node scripts/build.mjs",
    "prepack": "npm run build",
    "check": "npm run format:check && npm run build && tsc -p tsconfig.test.json && npm test",
    "smoke": "tsx scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "dsh-plugin",
    "watchdog",
    "jev"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hirate99/dsh-run-watchdog.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-deepseek-account": "^0.2.1-alpha.3",
    "@deepseek-ai/dsh-jobs": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-jobs-local": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.3",
    "@types/node": "26.6.5",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/client.js",
    "dist/*.d.ts",
    "README.md",
    "README.zh-CN.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2 || 0.2.1-alpha.3",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2 || 0.2.1-alpha.3",
    "@deepseek-ai/dsh-jobs": "0.2.0-rc.2 || 0.2.1-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2 || 0.2.1-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  }
}
